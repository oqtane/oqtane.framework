@namespace Oqtane.Modules.Admin.Files
@inherits StorageProviderSettingsControlBase
@inject IFolderService FolderService
@inject ISettingService SettingService
@inject IStringLocalizer<CustomStorageProviderSettingsControl> Localizer

<div class="row mb-1 align-items-center">
    <Label Class="col-sm-3" For="folderpath" ResourceKey="FolderPath" ResourceType="@resourceType" HelpText="A relative path on the local server">Folder Path: </Label>
    <div class="col-sm-9">
        <input id="folderpath" class="form-control" @bind="@_folderPath" />
    </div>
</div>

@code {
    private string _folderPath = "";
    private string resourceType = "Oqtane.Modules.Admin.Files.CustomStorageProviderSettingsControl, Oqtane.Client"; // for localization

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingService.GetSettingsAsync(EntityNames.StorageLocation, StorageLocationId);
        if (settings.ContainsKey("FolderPath"))
        {
            _folderPath = settings["FolderPath"];
        }       
    }

    public override async Task<IDictionary<string, string>> GetSettingsAsync()
    {
        return new Dictionary<string, string>
        {
            { "FolderPath", _folderPath }
        };
    }
}
