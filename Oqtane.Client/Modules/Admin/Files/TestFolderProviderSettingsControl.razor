@namespace Oqtane.Modules.Admin.Files
@inherits FolderProviderSettingsControlBase
@inject IFolderService FolderService
@inject ISettingService SettingService
@inject IStringLocalizer<TestFolderProviderSettingsControl> Localizer

<div class="row mb-1 align-items-center">
    <Label Class="col-sm-3" For="folderpath" ResourceKey="FolderPath" ResourceType="@resourceType" HelpText="The folder path">Folder Path: </Label>
    <div class="col-sm-9">
        <input id="folderpath" class="form-control" @bind="@_folderPath" />
    </div>
</div>

@code {
    private string _folderPath = "";
    private string resourceType = "Oqtane.Modules.Admin.Files.TestFolderProviderSettingsControl, Oqtane.Client"; // for localization

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingService.GetSettingsAsync(EntityNames.FolderConfig, FolderConfigId);
        if (settings.ContainsKey("FolderPath"))
        {
            _folderPath = settings["FolderPath"];
        }       
    }

    public override async Task<IDictionary<string, string>> GetSettingsAsync()
    {
        return new Dictionary<string, string>
        {
            { "FolderPath", _folderPath }
        };
    }
}
