@namespace Oqtane.Modules.Admin.Files
@inherits ModuleBase
@inject ISettingService SettingService
@inject IServiceProvider ServiceProvider
@inject IStorageLocationService StorageLocationService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Storage> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

@if (_providers != null)
{
    <form @ref="form" class="@(validated ? "was-validated" : "needs-validation")" novalidate>
        <div class="container">
            <div class="row mb-1 align-items-center">
                <Label Class="col-sm-3" For="provider" HelpText="Select the storage provider" ResourceKey="StorageProvider">Storage Provider:</Label>
                <div class="col-sm-9">
                    @if (_storageLocationId != -1)
                    {
                        <input id="provider" class="form-control" value="@_provider" disabled />
                    }
                    else
                    {
                        <select id="provider" class="form-select" value="@_provider" @onchange="OnProviderChanged" required>
                            <option value="-">&lt;@SharedLocalizer["Not Specified"]&gt;</option>
                            @foreach (var item in _providers.Where(i => !Constants.DefaultStorageProviders.Contains(i.Type)))
                            {
                                <option value="@item.Type">@item.DisplayName</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <div class="row mb-1 align-items-center">
                <Label Class="col-sm-3" For="storagelocation" HelpText="Enter the name of the storage location" ResourceKey="StorageLocation">Name:</Label>
                <div class="col-sm-9">
                    <input id="storagelocation" class="form-control" maxlength="255" @bind="_name" required />
                </div>
            </div>
            @if (_storageProviderSettingsFragment != null)
            {
                <hr />
                @_storageProviderSettingsFragment
            }
        </div>
    </form>
    <br />
    <button type="button" class="btn btn-success" @onclick="SaveStorageLocation">@SharedLocalizer["Save"]</button>
    @((MarkupString)"&nbsp;")
    <NavLink class="btn btn-secondary" href="@(ReturnUrl())">@SharedLocalizer["Cancel"]</NavLink>
}

@code {
    private ElementReference form;
    private bool validated = false;
    private int _storageLocationId = -1;
    private IList<StorageProvider> _providers;
    private string _provider = "-";
    private string _name;
    private IStorageProviderSettingsControl _storageProviderSettingsControl;
    private RenderFragment _storageProviderSettingsFragment;

    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Admin;

    public override string Title => "Storage Management";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _providers = await StorageLocationService.GetProvidersAsync();

            if (PageState.QueryString.ContainsKey("id"))
            {
                _storageLocationId = Int32.Parse(PageState.QueryString["id"]);
                var storageLocation = await StorageLocationService.GetStorageLocationAsync(_storageLocationId);
                if (storageLocation != null)
                {
                    _provider = _providers.FirstOrDefault(p => p.Type == storageLocation.Provider)?.DisplayName;
                    _name = storageLocation.Name;
                }
            }

            await LoadStorageProviderSettingsControl();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Storage Location {StorageLocationId}", _storageLocationId);
            AddModuleMessage(Localizer["Error.StorageLocation.Load"], MessageType.Error);
        }
    }

    private async Task SaveStorageLocation()
    {
        validated = true;
        var interop = new Interop(JSRuntime);
        if (await interop.FormValid(form))
        {
            if (_provider == "-")
            {
                AddModuleMessage(Localizer["Message.Required.Provider"], MessageType.Warning);
                return;
            }

            try
            {
                // check for duplicate storage location
                var storageLocations = await StorageLocationService.GetStorageLocationsAsync(PageState.Site.SiteId);
                if (storageLocations.Any(i => i.Name.Equals(_name, StringComparison.OrdinalIgnoreCase) && i.StorageLocationId != _storageLocationId))
                {
                    AddModuleMessage(Localizer["Message.StorageLocation.Duplicate"], MessageType.Warning);
                    return;
                }

                var storageLocation = new StorageLocation
                {
                    SiteId = PageState.Site.SiteId,
                    Name = _name,
                    Provider = _provider
                };
                if (_storageLocationId != -1)
                {
                    storageLocation = storageLocations.First(item => item.StorageLocationId == _storageLocationId);
                    storageLocation.Name = _name;
                    storageLocation = await StorageLocationService.UpdateStorageLocationAsync(storageLocation);
                }
                else
                {
                    storageLocation = await StorageLocationService.AddStorageLocationAsync(storageLocation);
                }

                if (_storageProviderSettingsControl != null)
                {
                    var settings = await _storageProviderSettingsControl.GetSettingsAsync();
                    if (settings != null)
                    {
                        await StorageLocationService.SaveSettingsAsync(storageLocation.StorageLocationId, settings);
                    }
                }

                if (storageLocation != null)
                {
                    await logger.LogInformation("Storage Location Saved {StorageLocation}", storageLocation);
                    NavigationManager.NavigateTo(ReturnUrl());
                }
                else
                {
                    AddModuleMessage(Localizer["Error.StorageLocation.Save"], MessageType.Error);
                }
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Error Saving Storage Location {StorageLocationId}", _storageLocationId);
                AddModuleMessage(Localizer["Error.StorageLocation.Save"], MessageType.Error);
            }
        }
        else
        {
            AddModuleMessage(SharedLocalizer["Message.InfoRequired"], MessageType.Warning);
        }
    }

    private async Task OnProviderChanged(ChangeEventArgs e)
    {
        _provider = e.Value.ToString();
        await LoadStorageProviderSettingsControl();
    }

    private async Task LoadStorageProviderSettingsControl()
    {
        _storageProviderSettingsControl = null;
        _storageProviderSettingsFragment = null;

        var settingsControlType = _providers.FirstOrDefault(p => p.Type == _provider)?.ControlType;
        if (!string.IsNullOrEmpty(settingsControlType))
        {
            var type = Type.GetType(settingsControlType);
            if (type != null && typeof(IStorageProviderSettingsControl).IsAssignableFrom(type))
            {
                _storageProviderSettingsFragment = builder =>
                {
                    var sequence = 0;
                    builder.OpenComponent(sequence++, type);
                    builder.AddAttribute(sequence++, "StorageLocationId", _storageLocationId);
                    builder.AddComponentReferenceCapture(sequence++, e => _storageProviderSettingsControl = (IStorageProviderSettingsControl)e);

                    builder.CloseComponent();
                };
            }
        }
    }

    private string ReturnUrl()
    {
        return NavigateUrl(PageState.Page.Path, "tab=storage");
    }
}