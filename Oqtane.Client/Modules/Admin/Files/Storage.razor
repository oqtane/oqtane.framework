@namespace Oqtane.Modules.Admin.Files
@inherits ModuleBase
@inject ISettingService SettingService
@inject IServiceProvider ServiceProvider
@inject IStorageLocationService StorageLocationService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Storage> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

@if (_providers != null)
{
    <form @ref="form" class="@(validated ? "was-validated" : "needs-validation")" novalidate>
        <div class="container">
            <div class="row mb-1 align-items-center">
                <Label Class="col-sm-3" For="provider" HelpText="Select the folder provider." ResourceKey="FolderProvider">Folder Provider:</Label>
                <div class="col-sm-9">
                    @if (_storageLocationId > 0)
                    {
                        <input id="provider" class="form-control" value="@_provider" disabled />
                    }
                    else
                    {
                        <select id="provider" class="form-select" value="@_provider" @onchange="OnProviderChanged" required>
                            @foreach (var item in _providers.Where(i => _storageLocationId > 0 || !Constants.DefaultFolderProviders.Contains(i.Type)))
                            {
                                <option value="@item.Type">@item.DisplayName</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <div class="row mb-1 align-items-center">
                <Label Class="col-sm-3" For="storagelocation" HelpText="Enter the name of the storage location" ResourceKey="StorageLocation">Name:</Label>
                <div class="col-sm-9">
                    <input id="storagelocation" class="form-control" @bind="_name" required />
                </div>
            </div>
            @if (_folderProviderSettingsFragment != null)
            {
                <hr />
                @_folderProviderSettingsFragment
            }
        </div>
    </form>
    <br />
    <button type="button" class="btn btn-success" @onclick="SaveStorageLocation">@SharedLocalizer["Save"]</button>
    @((MarkupString)"&nbsp;")
    <NavLink class="btn btn-secondary" href="@(ReturnUrl())">@SharedLocalizer["Cancel"]</NavLink>
}

@code {
    private ElementReference form;
    private bool validated = false;
    private IList<FolderProvider> _providers;
    private IEnumerable<StorageLocation> _storageLocations;
    private int _storageLocationId = -1;
    private string _name;
    private string _provider;
    private IFolderProviderSettingsControl _folderProviderSettingsControl;
    private RenderFragment _folderProviderSettingsFragment;

    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Admin;

    public override string Title => "Storage Management";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _providers = await StorageLocationService.GetProvidersAsync();
            _storageLocations = await StorageLocationService.GetStorageLocationsAsync(PageState.Site.SiteId);

            //remove default provider from the list
            foreach (var defaultProvider in Constants.DefaultFolderProviders)
            {
                var item = _providers.FirstOrDefault(i => i.Type == defaultProvider);
                if (item != null)
                {
                    _providers.Remove(item);
                }
            }

            if (PageState.QueryString.ContainsKey("id"))
            {
                _storageLocationId = Int32.Parse(PageState.QueryString["id"]);
                var storageLocation = await StorageLocationService.GetStorageLocationAsync(_storageLocationId);
                if (storageLocation != null)
                {
                    _name = storageLocation.Name;
                    _provider = storageLocation.Provider;
                }
            }
            else
            {
                _provider = _providers.FirstOrDefault()?.Type;
            }

            await LoadFolderProviderSettingsControl();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Folder Config {StorageLocationId} {Error}", _storageLocationId, ex.Message);
            AddModuleMessage(Localizer["Error.StorageLocation.Load"], MessageType.Error);
        }
    }

    private async Task SaveStorageLocation()
    {
        validated = true;
        var interop = new Interop(JSRuntime);
        if (await interop.FormValid(form))
        {
            if (string.IsNullOrEmpty(_name))
            {
                AddModuleMessage(Localizer["Message.Required.Name"], MessageType.Warning);
                return;
            }

            try
            {
                var storageLocation = _storageLocationId > 0 ? await StorageLocationService.GetStorageLocationAsync(_storageLocationId) : new StorageLocation();

                // check for duplicate folder config names
                if (_storageLocations.Any(i => i.Name.Equals(_name, StringComparison.OrdinalIgnoreCase) && i.StorageLocationId != _storageLocationId))
                {
                    AddModuleMessage(Localizer["Message.StorageLocation.Duplicate"], MessageType.Warning);
                    return;
                }

                storageLocation.SiteId = PageState.Site.SiteId;
                storageLocation.Name = _name;
                storageLocation.Provider = _provider;

                if (_storageLocationId >  0)
                {
                    storageLocation = await StorageLocationService.UpdateStorageLocationAsync(storageLocation);
                }
                else
                {
                    storageLocation = await StorageLocationService.AddStorageLocationAsync(storageLocation);
                    _storageLocationId = storageLocation.StorageLocationId;
                }

                if (_folderProviderSettingsControl != null)
                {
                    var settings = await _folderProviderSettingsControl.GetSettingsAsync();
                    if (settings != null)
                    {
                        await StorageLocationService.SaveSettingsAsync(storageLocation.StorageLocationId, settings);
                    }
                }

                if (storageLocation != null)
                {
                    await logger.LogInformation("Folder Config Saved {StorageLocation}", storageLocation);
                    NavigationManager.NavigateTo(ReturnUrl());
                }
                else
                {
                    AddModuleMessage(Localizer["Error.StorageLocation.Save"], MessageType.Error);
                }
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Error Saving Folder Config {StorageLocationId} {Error}", _storageLocationId, ex.Message);
                AddModuleMessage(Localizer["Error.StorageLocation.Save"], MessageType.Error);
            }
        }
        else
        {
            AddModuleMessage(SharedLocalizer["Message.InfoRequired"], MessageType.Warning);
        }
    }

    private async Task OnProviderChanged(ChangeEventArgs e)
    {
        _provider = e.Value.ToString();
        await LoadFolderProviderSettingsControl();
    }

    private async Task LoadFolderProviderSettingsControl()
    {
        _folderProviderSettingsControl = null;
        _folderProviderSettingsFragment = null;

        var settingsControlType = _providers.FirstOrDefault(p => p.Type == _provider)?.ControlType;
        if (!string.IsNullOrEmpty(settingsControlType))
        {
            var type = Type.GetType(settingsControlType);
            if (type != null && typeof(IFolderProviderSettingsControl).IsAssignableFrom(type))
            {
                _folderProviderSettingsFragment = builder =>
                {
                    var sequence = 0;
                    builder.OpenComponent(sequence++, type);
                    builder.AddAttribute(sequence++, "StorageLocationId", _storageLocationId);
                    builder.AddComponentReferenceCapture(sequence++, e => _folderProviderSettingsControl = (IFolderProviderSettingsControl)e);

                    builder.CloseComponent();
                };
            }
        }
    }

    private string ReturnUrl()
    {
        var returnUrl = !string.IsNullOrEmpty(PageState.ReturnUrl) ? PageState.ReturnUrl : NavigateUrl();
        if (!returnUrl.Contains("cid=") && _storageLocationId > 0)
        {
            var delimiter = returnUrl.Contains("?") ? "&" : "?";
            returnUrl += $"{delimiter}cid={_storageLocationId}";
        }
        return returnUrl;
    }
}